{
  "name": "cursor-as-a-service-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "start": "tsx --env-file=../.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test 'test/cursor/**/*.test.ts' 'test/routes/**/*.test.ts' 'test/state/**/*.test.ts' 'test/skills/**/*.test.ts'",
    "test:evals": "node --import tsx --test 'test/evals/**/*.test.ts'",
    "test:all": "npm test && npm run test:evals"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.7",
    "better-sqlite3": "12.10.0",
    "fastify": "^5.1.0",
    "fastify-sse-v2": "^4.2.2",
    "pino-pretty": "^11.2.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3"
  }
}
