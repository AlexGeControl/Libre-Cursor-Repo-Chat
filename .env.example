# Cursor — used by the adapter (via @cursor/sdk@1.0.7) for every
# Agent.create / Agent.resume / agent.send call against api.cursor.com.
# Must be a valid key for an account that is NOT subject to the
# /v1/models entitlement gate documented in docs/PHASE1.md.
CURSOR_API_KEY=crsr_api_key_here

# Optional — O'Reilly Books MCP integration token. Only the
# context-mgmt-eval-v1 workspace's mcp.json references it (the
# `${OREILLY_MCP_TOKEN}` placeholder is expanded by the adapter at
# Agent.create time). Without this, the MCP eval (C1) skips cleanly.
OREILLY_MCP_TOKEN=

# Optional adapter tuning. Defaults are 24h TTL / 30min sweep — the
# values are fractional-friendly so smoke tests can dial them down
# (e.g. ADAPTER_IDLE_TTL_HOURS=0.001 → ~3.6s).
# ADAPTER_IDLE_TTL_HOURS=24
# ADAPTER_SWEEPER_INTERVAL_MIN=30

# LibreChat — see docs/ARCHITECTURE.md.
# Regenerate the four secrets below per deployment, e.g. with:
#   openssl rand -hex 32   (JWT_SECRET, JWT_REFRESH_SECRET, CREDS_KEY)
#   openssl rand -hex 16   (CREDS_IV)
HOST=0.0.0.0
PORT=3080
MONGO_URI=mongodb://mongodb:27017/LibreChat
JWT_SECRET=replace_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_openssl_rand_hex_32
CREDS_KEY=replace_with_openssl_rand_hex_32
CREDS_IV=replace_with_openssl_rand_hex_16
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true

# LibreChat default-endpoint placeholders. user_provided means "let the
# user paste their own key in the UI" and is the right value here even
# when we don't use these endpoints, because LibreChat will refuse to
# start if a referenced endpoint has an undefined key.
ANTHROPIC_API_KEY=user_provided
OPENAI_API_KEY=user_provided
GOOGLE_KEY=user_provided

# Restrict the visible endpoint set to our custom one.
ENDPOINTS=custom
