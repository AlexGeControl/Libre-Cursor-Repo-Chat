# =============================================================================
# Cursor adapter
# =============================================================================

# Cursor — used by the adapter (via @cursor/sdk@1.0.7) for every
# Agent.create / Agent.resume / agent.send call against api.cursor.com.
# Must be a valid key for an account that is NOT subject to the
# /v1/models entitlement gate documented in docs/PHASE1.md.
CURSOR_API_KEY=crsr_api_key_here

# Optional — O'Reilly Books MCP integration token. Only the
# context-mgmt-eval-v1 workspace's mcp.json references it (the
# `${OREILLY_MCP_TOKEN}` placeholder is expanded by the adapter at
# Agent.create time). Without this, the MCP eval (C1) skips cleanly.
OREILLY_MCP_TOKEN=

# Optional adapter tuning. Defaults are 24h TTL / 30min sweep — the
# values are fractional-friendly so smoke tests can dial them down
# (e.g. ADAPTER_IDLE_TTL_HOURS=0.001 → ~3.6s).
# ADAPTER_IDLE_TTL_HOURS=24
# ADAPTER_SWEEPER_INTERVAL_MIN=30

# =============================================================================
# LibreChat — core
# =============================================================================
# See docs/ARCHITECTURE.md for the operating manual and
# docs/LibreChat/config-reference.md for what each env var below does.
# Regenerate the four secrets per deployment, e.g.:
#   openssl rand -hex 32   (JWT_SECRET, JWT_REFRESH_SECRET, CREDS_KEY)
#   openssl rand -hex 16   (CREDS_IV)

HOST=0.0.0.0
PORT=3080
MONGO_URI=mongodb://mongodb:27017/LibreChat
JWT_SECRET=replace_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_openssl_rand_hex_32
CREDS_KEY=replace_with_openssl_rand_hex_32
CREDS_IV=replace_with_openssl_rand_hex_16

# =============================================================================
# LibreChat — auth (local username/password for the MVP)
# =============================================================================
# SSO is Phase-3 work; today we use local auth only.

ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
# ALLOW_SOCIAL_LOGIN=false
# ALLOW_SOCIAL_REGISTRATION=false
# ALLOW_PASSWORD_RESET=false
# ALLOW_UNVERIFIED_EMAIL_LOGIN=true

# =============================================================================
# LibreChat — endpoint allow-list
# =============================================================================
# `ENDPOINTS=custom` restricts the model-selector dropdown to our
# custom endpoint ("Cursor Workspaces") only. Without it, all
# built-in endpoints whose keys are present will appear in the UI.
# Source: packages/data-provider/src/parsers.ts:70-92.

ENDPOINTS=custom

# Default-endpoint placeholders. `user_provided` means "let the user
# paste their own key in the UI" and is the right value even when we
# don't expose these endpoints, because LibreChat will refuse to start
# if a referenced endpoint has an undefined key.
ANTHROPIC_API_KEY=user_provided
OPENAI_API_KEY=user_provided
GOOGLE_KEY=user_provided

# =============================================================================
# LibreChat — branding (env-only; yaml has no equivalents for these)
# =============================================================================

# Browser tab title (set dynamically post-React-mount; the pre-mount
# flash shows the hardcoded `client/index.html:11` "LibreChat" value).
# Source: api/server/routes/config.js:45.
# APP_TITLE=Cursor Workspaces

# In-app "Help & FAQ" link target.
# Source: api/server/routes/config.js:76.
# HELP_AND_FAQ_URL=https://internal.example/cursor-workspaces

# Footer text. Default (unset) is
# "[LibreChat <version>](https://librechat.ai) - Every AI for Everyone".
# Supports markdown links and `|` separators (each pipe-segment renders
# as a separate inline element with a vertical-bar separator).
# Source: api/server/routes/config.js:96-97, client/src/components/Chat/Footer.tsx:28-93.
# CUSTOM_FOOTER="[Cursor Workspaces](https://internal.example) — NVIDIA HW Infra | Built on [LibreChat](https://librechat.ai)"

# =============================================================================
# LibreChat — feature gates
# =============================================================================

# Conversation search bar (left sidebar) + /api/search route.
# Requires Meilisearch reachable when true. Set false (or omit) to
# skip the Meilisearch dependency entirely.
# Source: api/server/routes/search.js:11.
SEARCH=false

# Share-link UI item inside the Export menu + the /share/... route.
# The Export menu shell itself is unconditional (fork-only to hide);
# this only controls the Share entry inside it.
# Source: api/server/routes/share.js:18-25, api/server/routes/config.js:15-18.
ALLOW_SHARED_LINKS=false
# ALLOW_SHARED_LINKS_PUBLIC=false

# =============================================================================
# LibreChat — Meilisearch (only required when SEARCH=true)
# =============================================================================
# Leave commented unless SEARCH=true above. If enabled, also add the
# meilisearch service in docker-compose.yml.
# MEILI_NO_ANALYTICS=true
# MEILI_HOST=http://meilisearch:7700
# MEILI_MASTER_KEY=replace_with_meilisearch_master_key

# =============================================================================
# LibreChat — operational
# =============================================================================
# Sane defaults; uncomment to change.

# Tells crawlers not to index — typical for internal deployments.
# NO_INDEX=true

# Trust the first proxy hop (set higher if behind multiple proxies).
# TRUST_PROXY=1

# Public-facing URLs for redirects / share-links / OAuth callbacks.
# Bump to your internal hostname when deploying behind a reverse proxy.
# DOMAIN_CLIENT=http://localhost:3080
# DOMAIN_SERVER=http://localhost:3080

# Logging knobs.
# DEBUG_LOGGING=true
# DEBUG_CONSOLE=false
