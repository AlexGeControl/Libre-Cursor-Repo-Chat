# Cursor — used by the proxy and the spawned agent CLI.
CURSOR_API_KEY=crsr_api_key_here

# LibreChat — see docs/ARCHITECTURE.md.
# Regenerate the four secrets below per deployment, e.g. with:
#   openssl rand -hex 32   (JWT_SECRET, JWT_REFRESH_SECRET, CREDS_KEY)
#   openssl rand -hex 16   (CREDS_IV)
HOST=0.0.0.0
PORT=3080
MONGO_URI=mongodb://mongodb:27017/LibreChat
JWT_SECRET=replace_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_openssl_rand_hex_32
CREDS_KEY=replace_with_openssl_rand_hex_32
CREDS_IV=replace_with_openssl_rand_hex_16
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true

# LibreChat default-endpoint placeholders. user_provided means "let the
# user paste their own key in the UI" and is the right value here even
# when we don't use these endpoints, because LibreChat will refuse to
# start if a referenced endpoint has an undefined key.
ANTHROPIC_API_KEY=user_provided
OPENAI_API_KEY=user_provided
GOOGLE_KEY=user_provided

# Restrict the visible endpoint set to our custom one.
ENDPOINTS=custom
